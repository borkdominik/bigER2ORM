orm_model dst_tu_wien

enum TripStatus {
    CREATED
    MATCHED
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

embeddable Money {
    currency String
    value Float
}

mapped_class PlatformUser {
    id UUID key
    name String
    tel String required
    avgRating Float
}

entity Rider extends PlatformUser {
    email String required
    password String required
    accountNo String
    bankCode String
}

entity Driver extends PlatformUser {
}

entity Preferences {
    id UUID key
}

entity PreferencesData {
    id UUID key
    dataKey String required
    data String
}

entity Organization {
    id UUID key
    name String
}

entity Vehicle {
    id UUID key
    license String
    type String
    color String
}

entity Location {
    id UUID key
    name String
    locationId Integer
}

entity TripInfo {
    id UUID key
    completed DateTime
    distance Float
    embedded total Money
    driverRating Integer
    riderRating Integer
}

entity Trip {
    id UUID key
    created DateTime
    updated DateTime
    enum state TripStatus
}

entity Match {
    id UUID key
    date DateTime
    embedded fare Money
}

entity Employment joins (Driver["employments"], Organization["employments"]) {
    since DateTime
    active Boolean
}

ManyToMany relationship OrganizationParts {
    source Organization["partsorganization"]
    target Organization["partoforganization"]
}

ManyToMany relationship OrganizationVehicle {
    source Organization["organizations"]
    target Vehicle["vehicles"]
}

OneToOne relationship RiderPreferences {
    source Rider["preferences"]
    target Preferences["rider"]
}

ManyToOne relationship PreferencesDataPreferences {
    source PreferencesData["preferences"] required
    target Preferences["data"]
}

OneToOne relationship TripTripInfo {
    source TripInfo["trip"]
    target Trip["tripInfo"]
}

OneToOne relationship TripPickup {
    source Trip["pickup"]
    target Location["pickupTrip"]
}

OneToOne relationship TripDestination {
    source Trip["destination"]
    target Location["destinationTrip"]
}

ManyToMany relationship TripLocation {
    source Trip["stops"]
    target Location["stopsTrip"]
}

OneToOne relationship MatchTrip {
    source Match["trip"]
    target Trip["match"]
}

ManyToOne relationship MatchDriver {
    source Match["driver"] required
    target Driver["matches"]
}

ManyToOne relationship MatchVehicle {
    source Match["vehicle"] required
    target Vehicle["matches"]
}

ManyToOne relationship DriverVehicle {
    source Driver["vehicle"] required
    target Vehicle["drivers"]
}

ManyToOne relationship TripRider {
    source Trip["rider"]
    target Rider["trips"]
}

