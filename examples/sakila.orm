orm_model sakila

enum Rating {
    G
    PG
    PG_13
    R
    NC_17
}

entity Actor {
    id Integer key
    @(Attribute.Length=45)
    firstName String required
    @(Attribute.Length=45)
    lastName String required
    lastUpdate DateTime required
}

entity Category {
    id Integer key
    @(Attribute.Length=25)
    name String required
    lastUpdate DateTime required
}

entity Language {
    id Integer key
    @(Attribute.Length=20)
    name String required
    lastUpdate DateTime required
}

entity Film {
    id Integer key
    @(Attribute.Length=128)
    title String required
    description String
    releaseYear Integer
    rentalDuration Integer required
    rentalRate Float required
    length Integer
    replacementCost Float required
    enum rating Rating
    specialFeatures String
    lastUpdate DateTime required
}

entity FilmActor joins (Film["filmActors"], Actor["filmActors"]) {
    lastUpdate DateTime required
}

entity FilmCategory joins (Film["filmCategories"], Category["films"]) {
    lastUpdate DateTime required
}

entity Address {
    id Integer key
    @(Attribute.Length=50)
    addressLine String required
    @(Attribute.Length=50)
    addressTwo String
    @(Attribute.Length=20)
    district String required
    @(Attribute.Length=10)
    postalCode String
    @(Attribute.Length=20)
    phone String required
    location String required
    lastUpdate DateTime required
}

entity City {
    id Integer key
    @(Attribute.Length=50)
    name String required
    lastUpdate DateTime required
}

entity Country {
    id Integer key
    @(Attribute.Length=50)
    name String required
    lastUpdate DateTime required
}

entity Store {
    id Integer key
    lastUpdate DateTime required
}

entity Staff {
    id Integer key
    @(Attribute.Length=45)
    firstName String required
    @(Attribute.Length=45)
    lastName String required
    picture String
    email String
    active Boolean required
    @(Attribute.Length=16)
    username String required
    password String
    lastUpdate DateTime required
}

entity Customer {
    id Integer key
    @(Attribute.Length=45)
    firstName String required
    @(Attribute.Length=45)
    lastName String required
    email String
    active Boolean required
    createDate DateTime required
    lastUpdate DateTime required
}

entity Inventory {
    id Integer key
    lastUpdate DateTime required
}

entity Rental {
    id Integer key
    rentalDate DateTime required
    returnDate DateTime
    lastUpdate DateTime required
}

entity Payment {
    id Integer key
    amount Float required
    paymentDate DateTime required
    lastUpdate DateTime required
}

ManyToOne relationship FilmLanguage {
    source Film["language"] required
    target Language["films"]
}

ManyToOne relationship FilmOriginalLanguage {
    source Film["originalLanguage"]
    target Language["originalLanguageFilms"]
}

ManyToOne relationship InventoryFilm {
    source Inventory["film"] required
    target Film["inventories"]
}

ManyToOne relationship InventoryStore {
    source Inventory["store"] required
    target Store["inventories"]
}

ManyToOne relationship StaffStore {
    source Staff["store"] required
    target Store["staffMembers"]
}

ManyToOne relationship StoreAddress {
    source Store["address"] required
    target Address["stores"]
}

OneToOne relationship StoreManager {
    source Store["managerStaff"]
    target Staff["managedStore"]
}

ManyToOne relationship StaffAddress {
    source Staff["address"] required
    target Address["staffMembers"]
}

ManyToOne relationship CustomerStore {
    source Customer["store"] required
    target Store["customers"]
}

ManyToOne relationship CustomerAddress {
    source Customer["address"] required
    target Address["customers"]
}

ManyToOne relationship AddressCity {
    source Address["city"] required
    target City["addresses"]
}

ManyToOne relationship CityCountry {
    source City["country"] required
    target Country["cities"]
}

ManyToOne relationship RentalInventory {
    source Rental["inventory"] required
    target Inventory["rentals"]
}

ManyToOne relationship RentalCustomer {
    source Rental["customer"] required
    target Customer["rentals"]
}

ManyToOne relationship RentalStaff {
    source Rental["staff"] required
    target Staff["rentals"]
}

ManyToOne relationship PaymentCustomer {
    source Payment["customer"] required
    target Customer["payments"]
}

ManyToOne relationship PaymentStaff {
    source Payment["staff"] required
    target Staff["payments"]
}

ManyToOne relationship PaymentRental {
    source Payment["rental"]
    target Rental["payments"]
}
