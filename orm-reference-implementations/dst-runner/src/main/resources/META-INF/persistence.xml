<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
  <persistence-unit name="dst_reference_pu">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <mapping-file>META-INF/Trip.xml</mapping-file>
    <mapping-file>META-INF/orm.xml</mapping-file>
    <class>dst.ass1.jpa.model.impl.PlatformUser</class>
    <class>dst.ass1.jpa.model.impl.Driver</class>
    <class>dst.ass1.jpa.model.impl.Rider</class>
    <class>dst.ass1.jpa.model.impl.Organization</class>
    <class>dst.ass1.jpa.model.impl.Employment</class>
    <class>dst.ass1.jpa.model.impl.Location</class>
    <class>dst.ass1.jpa.model.impl.Trip</class>
    <class>dst.ass1.jpa.model.impl.TripInfo</class>
    <class>dst.ass1.jpa.model.impl.Vehicle</class>
    <class>dst.ass1.jpa.model.impl.Money</class>
    <class>dst.ass1.jpa.model.impl.Preferences</class>
    <class>dst.ass1.jpa.model.impl.Match</class>
    <properties>
      <property name="javax.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <property name="javax.persistence.jdbc.url" value="jdbc:postgresql://postgres:5432/dst_reference"/>
      <property name="javax.persistence.jdbc.user" value="postgres"/>
      <property name="javax.persistence.jdbc.password" value="postgres"/>
      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
      <property name="hibernate.hbm2ddl.auto" value="create"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
